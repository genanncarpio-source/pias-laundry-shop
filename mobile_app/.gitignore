# Local API configuration and secrets
**/.env
**/.env.*
!**/.env.example

# Expo generated files
expo_app/node_modules/
expo_app/.expo/
expo_app/dist/
expo_app/.tmp-*-export/
expo_app/*.apk
expo_app/*.aab

# Flutter generated files and machine-specific settings
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/android/local.properties
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/.idea/
flutter_app/*.iml
